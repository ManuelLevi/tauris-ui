{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauris-ui freeze check",
  "version": "0.0.0",
  "identifier": "dev.tauris-ui.freeze-check",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../examples/basic/src-tauri/icons/32x32.png",
      "../../examples/basic/src-tauri/icons/128x128.png",
      "../../examples/basic/src-tauri/icons/128x128@2x.png",
      "../../examples/basic/src-tauri/icons/icon.icns",
      "../../examples/basic/src-tauri/icons/icon.ico"
    ]
  }
}
